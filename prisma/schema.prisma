generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BlogPost {
  id              String    @id
  slug            String    @unique
  title           String
  bannerUrl       String
  outline         String
  content         Json
  readingTime     String
  keyTakeaways    String[]
  author          String    @default("Admin")
  category        String
  tags            String[]
  status          String    @default("draft")
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  articleSections Json      @default("[]")
  excerpt         String    @default("")
}

model CaseStudy {
  id                  String   @id
  slug                String   @unique
  status              String   @default("draft")
  createdAt           DateTime @default(now())
  updatedAt           DateTime
  breadcrumbTitle     String
  categoryBadge       String
  headerImageUrl      String   @default("")
  implementationSteps String[]
  keyResults          Json     @default("[]")
  mainHeading         String
  sections            Json     @default("[]")
  storyTitle          String
  testimonialQuote    String   @default("")
}

model Faq {
  id        String   @id
  question  String
  answer    String
  type      String
  scopeKey  String?
  category  String?
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model JobApplication {
  id              String      @id
  jobListingId    String?
  jobTitle        String
  jobCategory     String
  jobLocation     String
  fullName        String
  email           String
  phone           String?
  linkedin        String?
  currentLocation String?
  totalExperience String?
  noticePeriod    String?
  expectedCtc     String?
  source          String?
  coverLetter     String?
  resumeUrl       String?
  status          String      @default("new")
  createdAt       DateTime    @default(now())
  JobListing      JobListing? @relation(fields: [jobListingId], references: [id])
}

model JobListing {
  id               String           @id
  slug             String           @unique
  title            String
  category         String
  location         String
  type             String
  experience       String?
  salary           String
  status           String           @default("draft")
  description      String
  about            String[]
  responsibilities String[]
  requirements     String[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  JobApplication   JobApplication[]
}

model TeamMember {
  id          String   @id
  name        String
  role        String
  bio         String
  imageUrl    String
  linkedinUrl String?
  twitterUrl  String?
  mailTo      String?
  sortOrder   Int      @default(0)
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model Testimonial {
  id          String   @id
  content     String
  companyName String
  rating      Int      @default(5)
  logoUrl     String
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model Industry {
  id                       String   @id
  slug                     String   @unique
  name                     String
  status                   String   @default("published")
  heroTitle                String   @default("")
  heroTitleHighlight       String   @default("")
  heroDescription          String   @default("")
  heroDescriptionHighlight String   @default("")
  heroImageUrl             String   @default("")
  trustedLogos             String[]
  ctaTitle                 String   @default("")
  ctaTitleHighlight        String   @default("")
  featuresTitle            String   @default("")
  featuresTitleHighlight   String   @default("")
  featuresDescription      String   @default("")
  featureCards             Json     @default("[]")
  transformationLegacy     String[]
  transformationOutcomes   String[]
  pillarsTitle             String   @default("")
  pillarsTitleHighlight    String   @default("")
  pillarsSubtitle          String   @default("")
  productPillars           Json     @default("[]")
  caseStudy                Json     @default("{}")
  metricsTitle             String   @default("")
  metricsTitleHighlight    String   @default("")
  metrics                  Json     @default("[]")
  agentsTitle              String   @default("")
  agentsTitleHighlight     String   @default("")
  agentCards               Json     @default("[]")
  complianceTitle          String   @default("")
  complianceTitleHighlight String   @default("")
  complianceCards          Json     @default("[]")
  useCases                 Json     @default("[]")
  createdAt                DateTime @default(now())
  updatedAt                DateTime
}

model PlatformOs {
  id                     String   @id
  slug                   String   @unique
  name                   String
  status                 String   @default("published")
  heroTitle              String   @default("")
  heroTitleHighlight     String   @default("")
  heroDescription        String   @default("")
  heroImageUrl           String   @default("")
  clientsDescription     String   @default("")
  clientLogos            String[]
  whyTitle               String   @default("")
  whyTitleHighlight      String   @default("")
  whyDescription         String   @default("")
  whySteps               Json     @default("[]")
  intelTitle             String   @default("")
  intelTitleHighlight    String   @default("")
  intelDescription       String   @default("")
  intelSteps             Json     @default("[]")
  useCasesTitle          String   @default("")
  useCasesTitleHighlight String   @default("")
  useCasesCards          Json     @default("[]")
  impactTitle            String   @default("")
  impactTitleHighlight   String   @default("")
  impactMetrics          Json     @default("[]")
  securityTitle          String   @default("")
  securityTitleHighlight String   @default("")
  securityDescription    String   @default("")
  securityFeatures       Json     @default("[]")
  securityGridItems      String[]
  ctaTitle               String   @default("")
  ctaTitleHighlight      String   @default("")
  createdAt              DateTime @default(now())
  updatedAt              DateTime
}

model LegalDocument {
  id           String    @id
  slug         String    @unique
  title        String
  supportEmail String    @default("")
  bannerUrl    String    @default("")
  content      String    @default("")
  lastUpdated  DateTime?
  status       String    @default("published")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
}

model WhyFramework {
  id                      String   @id
  slug                    String   @unique
  categoryBadge           String   @default("")
  heroBannerText          String   @default("")
  mainHeading             String   @default("")
  introDescription        String   @default("")
  heroBannerImageUrl      String   @default("")
  featuredContentImageUrl String   @default("")
  sec1Tag                 String   @default("")
  sec1Heading             String   @default("")
  sec1Text                String   @default("")
  sec2Tag                 String   @default("")
  sec2Heading             String   @default("")
  sec2Text                String   @default("")
  componentsHeading       String   @default("")
  componentsSubheading    String   @default("")
  capabilities            String[]
  sec3Tag                 String   @default("")
  sec3Heading             String   @default("")
  sec3Text                String   @default("")
  results                 Json     @default("[]")
  status                  String   @default("published")
  createdAt               DateTime @default(now())
  updatedAt               DateTime
}
